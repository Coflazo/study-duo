{
  "name": "study-duo",
  "description": "Pomodoro timer, focus clock, tab locker and private study insights. Runs offline.",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "build:test": "STUDY_DUO_OUT=.test-build wxt build",
    "test:e2e": "npm run build:test && playwright test",
    "tokens": "node scripts/tokens-to-css.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tsconfig/svelte": "^5.0.8",
    "@wxt-dev/module-svelte": "^2.0.4",
    "fake-indexeddb": "^6.2.5",
    "svelte": "^5.53.7",
    "svelte-check": "^4.4.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^5.0.3",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  },
  "dependencies": {
    "idb": "^8.0.4"
  },
  "license": "MIT",
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
