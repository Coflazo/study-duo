 "lines": [
  {
   "id": "hook-1",
   "beat": "hook",
   "text": "You sit down to study at eight.",
   "start": 0.8,
   "end": 2.618
  },
  {
   "id": "hook-2",
   "beat": "hook",
   "text": "By nine, you've read one page and opened fourteen tabs.",
   "start": 3.118,
   "end": 6.822
  },
  {
   "id": "problem",
   "beat": "problem",
   "text": "So you install a blocker, and it wants you to sign up.",
   "start": 7.522,
   "end": 10.493
  },
  {
   "id": "reveal-1",
   "beat": "reveal",
   "text": "Study Duo is a study timer that lives in your browser.",
   "start": 11.993,
   "end": 15.847
  },
  {
   "id": "reveal-2",
   "beat": "reveal",
   "text": "Free, offline, and it never phones home.",
   "start": 16.247,
   "end": 18.817
  },
  {
   "id": "start-1",
   "beat": "start",
   "text": "Your deadlines come in from your course calendar.",
   "start": 19.717,
   "end": 22.485
  },
  {
   "id": "start-2",
   "beat": "start",
   "text": "Pick one and press Start.",
   "start": 23.285,
   "end": 24.908
  },
  {
   "id": "clock",
   "beat": "clock",
   "text": "A small clock sits in the corner of every page, and fades while you read.",
   "start": 25.908,
   "end": 30.396
  },
  {
   "id": "lock-1",
   "beat": "lock",
   "text": "Distracting sites stay closed until the block ends.",
   "start": 31.396,
   "end": 34.71
  },
  {
   "id": "lock-2",
   "beat": "lock",
   "text": "Opening one anyway takes ten seconds and a reason.",
   "start": 35.21,
   "end": 38.483
  },
  {
   "id": "noise",
   "beat": "noise",
   "text": "Need some sound? White, pink or brown noise, made right here.",
   "start": 39.783,
   "end": 43.893
  },
  {
   "id": "songs",
   "beat": "songs",
   "text": "Or play your own songs, straight from your computer.",
   "start": 48.693,
   "end": 51.727
  },
  {
   "id": "bell",
   "beat": "bell",
   "text": "When time's up, a bell rings and the page tells you to rest.",
   "start": 57.927,
   "end": 61.779
  },
  {
   "id": "rate",
   "beat": "rate",
   "text": "One tap says how focused you were.",
   "start": 63.279,
   "end": 65.381
  },
  {
   "id": "insights-1",
   "beat": "insights",
   "text": "After a few weeks, it knows your best hours,",
   "start": 66.581,
   "end": 69.252
  },
  {
   "id": "insights-2",
   "beat": "insights",
   "text": "and which songs actually help you focus.",
   "start": 69.502,
   "end": 71.984
  },
  {
   "id": "calendar",
   "beat": "calendar",
   "text": "Every block lands on your timeline, ready for any calendar.",
   "start": 73.584,
   "end": 77.293
  },
  {
   "id": "move",
   "beat": "move",
   "text": "New laptop? Move your settings and to-dos over with a QR code.",
   "start": 78.393,
   "end": 82.638
  },
  {
   "id": "proof-1",
   "beat": "proof",
   "text": "No account, no server.",
   "start": 83.838,
   "end": 85.541
  },
  {
   "id": "proof-2",
   "beat": "proof",
   "text": "When we installed BlockSite, it contacted fifty-six outside servers.",
   "start": 86.041,
   "end": 90.505
  },
  {
   "id": "proof-3",
   "beat": "proof",
   "text": "Study Duo contacted none.",
   "start": 91.005,
   "end": 92.975
  },
  {
   "id": "end",
   "beat": "end",
   "text": "Study Duo. Free and open source.",
   "start": 94.775,
   "end": 97.465
  }
 ],
