 "lines": [
  {
   "id": "hook-1",
   "beat": "hook",
   "text": "You sit down to study at eight.",
   "start": 0.8,
   "end": 2.618
  },
  {
   "id": "hook-2",
   "beat": "hook",
   "text": "By nine, you've read one page and opened fourteen tabs.",
   "start": 3.118,
   "end": 6.822
  },
  {
   "id": "problem",
   "beat": "problem",
   "text": "So you install a blocker, and it wants you to sign up.",
   "start": 7.522,
   "end": 10.493
  },
  {
   "id": "reveal-1",
   "beat": "reveal",
   "text": "Study Duo is a study timer that lives in your browser.",
   "start": 11.993,
   "end": 15.847
  },
  {
   "id": "reveal-2",
   "beat": "reveal",
   "text": "Free, offline, and it never phones home.",
   "start": 16.247,
   "end": 18.817
  },
  {
   "id": "start-1",
   "beat": "start",
   "text": "Your deadlines come in from your course calendar.",
   "start": 19.717,
   "end": 22.485
  },
  {
   "id": "start-2",
   "beat": "start",
   "text": "Pick one and press Start.",
   "start": 23.285,
   "end": 24.908
  },
  {
   "id": "clock",
   "beat": "clock",
   "text": "A small clock sits in the corner of every page, and fades while you read.",
   "start": 25.908,
   "end": 30.396
  },
  {
   "id": "lock-1",
   "beat": "lock",
   "text": "Distracting sites stay closed until the block ends.",
   "start": 31.396,
   "end": 34.71
  },
  {
   "id": "lock-2",
   "beat": "lock",
   "text": "Opening one anyway takes ten seconds and a reason.",
   "start": 35.21,
   "end": 38.483
  },
  {
   "id": "player",
   "beat": "noise",
   "text": "Under the timer sits a record player.",
   "start": 39.783,
   "end": 42.286
  },
  {
   "id": "noise",
   "beat": "noise",
   "text": "White, pink or brown noise, made right here.",
   "start": 42.786,
   "end": 45.689
  },
  {
   "id": "songs",
   "beat": "songs",
   "text": "Point it at your music folder, and it plays like a music app.",
   "start": 50.489,
   "end": 54.006
  },
  {
   "id": "streaming-1",
   "beat": "streaming",
   "text": "A YouTube or Spotify link plays in the side panel.",
   "start": 57.406,
   "end": 60.941
  },
  {
   "id": "streaming-2",
   "beat": "streaming",
   "text": "The popup plays, pauses and skips it.",
   "start": 61.441,
   "end": 63.846
  },
  {
   "id": "tabs",
   "beat": "tabs",
   "text": "Music already playing in another tab? Pause it or skip it from here.",
   "start": 64.746,
   "end": 68.855
  },
  {
   "id": "bell",
   "beat": "bell",
   "text": "When time's up, a bell rings and the page tells you to rest.",
   "start": 72.755,
   "end": 76.607
  },
  {
   "id": "rate",
   "beat": "rate",
   "text": "One tap says how focused you were.",
   "start": 78.107,
   "end": 80.209
  },
  {
   "id": "insights-1",
   "beat": "insights",
   "text": "After a few weeks, it knows your best hours,",
   "start": 81.409,
   "end": 84.08
  },
  {
   "id": "insights-2",
   "beat": "insights",
   "text": "and which songs actually help you focus.",
   "start": 84.33,
   "end": 86.812
  },
  {
   "id": "calendar",
   "beat": "calendar",
   "text": "Every block can land in your Google Calendar by itself.",
   "start": 88.412,
   "end": 91.877
  },
  {
   "id": "move",
   "beat": "move",
   "text": "New laptop? Move your settings and to-dos over with a QR code.",
   "start": 92.977,
   "end": 97.223
  },
  {
   "id": "proof-1",
   "beat": "proof",
   "text": "We measured it next to five other focus extensions.",
   "start": 98.423,
   "end": 101.793
  },
  {
   "id": "proof-2",
   "beat": "proof",
   "text": "When we installed BlockSite, it contacted fifty-seven outside servers.",
   "start": 102.293,
   "end": 106.901
  },
  {
   "id": "proof-3",
   "beat": "proof",
   "text": "Study Duo contacted none.",
   "start": 107.401,
   "end": 109.371
  },
  {
   "id": "price-1",
   "beat": "price",
   "text": "The paid focus apps cost up to nineteen ninety-nine a month.",
   "start": 110.771,
   "end": 114.829
  },
  {
   "id": "price-2",
   "beat": "price",
   "text": "All of this is free.",
   "start": 115.229,
   "end": 116.702
  },
  {
   "id": "end",
   "beat": "end",
   "text": "Study Duo. Free and open source.",
   "start": 118.302,
   "end": 120.992
  }
 ],
